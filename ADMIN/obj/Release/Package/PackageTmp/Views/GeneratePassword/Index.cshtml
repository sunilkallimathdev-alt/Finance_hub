
@{
    Layout = null;
}
<script src="~/CustomFiles/plugins/jquery/jquery.min.js"></script>
<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.16.0/jquery.validate.js"></script>
<script src="https://cdn.jsdelivr.net/jquery.validation/1.16.0/additional-methods.min.js"></script>
<script src="~/CustomFiles/js/Common_js.js"></script>
<script src="~/CustomFiles/dist/js/toastr.min.js"></script>
<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>Update PassWord | AVA Homes </title>
    <link rel="icon" href="~/CustomFiles/logo.png">
    <!-- Tell the browser to be responsive to screen width -->
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/font-awesome/4.4.0/css/font-awesome.min.css">
    <!-- Ionicons -->
    <link rel="stylesheet" href="https://code.ionicframework.com/ionicons/2.0.1/css/ionicons.min.css">
    <!-- Theme style -->
    <!-- iCheck -->
    <link href="~/CustomFiles/dist/css/adminlte.css" rel="stylesheet" />
    <a href="~/CustomFiles/dist/css/adminlte.css.map">
        <link href="~/CustomFiles/dist/css/loader.css" rel="stylesheet" />
        <link href="~/CustomFiles/dist/css/toastr.min.css" rel="stylesheet" />
        <!-- Google Font: Source Sans Pro -->
        <link href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700" rel="stylesheet">
        <style>
            #buttons {
                padding: 5px;
            }

            .error {
                color: red !important;
            }
        </style>
</head>
<body class="hold-transition login-page">
    <form id="GeneratePassword">
        <div class="login-box">
            <div class="login-logo">
                <a><img src="~/CustomFiles/logo.png" /></a>
            </div>
            <!-- /.login-logo -->
            <div class="card">
                <div class="card-body login-card-body">

                    <p class="login-box-msg">Update Password</p>

                    <div class="form-group has-feedback row">
                        <span class="fa fa-envelope form-control-feedback col-sm-1"></span>
                        <input type="text" name="UserName" placeholder="User Name" autofocus="autofocus" onkeypress="keyPressListener(event)" class="form-control col-sm-11">
                    </div>
                    <div class="form-group has-feedback row">
                        <span class="fa fa-lock form-control-feedback col-sm-1"></span>
                        <input type="password" name="Password" id="Password" placeholder="Password" onkeypress="keyPressListener(event)" class="form-control col-sm-11" maxlength="15">

                    </div>
                    <div class="form-group has-feedback row">
                        <span class="fa fa-lock form-control-feedback col-sm-1"></span>
                        <input type="password" name="ConfirmPassword" placeholder="ConfirmPassword" onkeypress="keyPressListener(event)" class="form-control col-sm-11" maxlength="15">

                    </div>
                    <div class="row">
                        <!-- /.col -->

                        <div class="col-md-12">
                            <button type="button" style="float:right;" id="btnsubmit" class="btn btn-success">Submit</button>
                        </div>
                        <!-- /.col -->
                    </div>
                    <!-- /.social-auth-links -->
                </div>
                <!-- /.login-card-body -->
            </div>
        </div>
    </form>
    <!-- /.login-box -->
    <!-- jQuery -->

    <script>
        function SuccessAlert(Title, Message) {
            toastr.success(Message, Title)
        }
        function WarningAlert(Title, Message) {
            toastr.warning(Message, Title)
        }
        function DangerAlert(Title, Message) {
            toastr.error(Message, Title)
        }

        $('#GeneratePassword').validate({
            rules: {
                UserName: {
                    required: true,
                },
                Password: {
                    minlength: 8,
                    required: true,
                },
                ConfirmPassword:{
                    minlength: 8,
                    equalTo: "#Password",
                }
            }
        });

        var form = $("#GeneratePassword");
        form.validate();

        $(document).ready(function () {

            $("#btnsubmit").click(function () {
                if (form.valid()) {
                    document.getElementById("btnsubmit").disabled = true;
                    var myobj = new Object();
                    myobj.UserName = $('[name="UserName"]').val();
                    myobj.Password = $('[name="Password"]').val();
                    $.post("@Url.Action("Addaa", "GeneratePassword")", { ObjVendor: JSON.stringify(myobj) }, function (data) {
                        var Res = JSON.parse(data);
                        if (Res>0 ) {
                            //SuccessAlert("@ViewBag.Title", "Login Successfully.");
                            localStorage.setItem("UserName", $('[name="UserName"]').val());
                            
                           // window.location.href = "/AdminLogin/Index";
                            var str = atob(location.pathname.substring(location.pathname.lastIndexOf("/") + 1)).split('_')[0];
                            if (str == "PLT") {
                                window.location.href = "/AdminLogin/Index";
                            }
                            else if (str == "TMM") {
                                window.location.href = "/BuilderLogin/Index/" + location.pathname.substring(location.pathname.lastIndexOf("/") + 1);
                            }
                            else if (str == "VEN") {
                                window.location.href = "/VendorLogin/Index/" + location.pathname.substring(location.pathname.lastIndexOf("/") + 1);
                            }
                            else if (str == "BLD") {
                                window.location.href = "/BuilderLogin/Index/" + location.pathname.substring(location.pathname.lastIndexOf("/") + 1);
                            }
                            else if (str == "OWN") {
                                window.location.href = "/OwnerLogin/Index/" + location.pathname.substring(location.pathname.lastIndexOf("/") + 1);
                            }
                            else if (str == "CUSTREP") {
                                window.location.href = "/CustomerRepLogin/Index/" + location.pathname.substring(location.pathname.lastIndexOf("/") + 1);
                            }
                            else if (str == "PREOWN") {
                                window.location.href = "/PreOwnerLogin/Index/" + location.pathname.substring(location.pathname.lastIndexOf("/") + 1);
                            }
                        }
                        else {
                            WarningAlert("@ViewBag.Title", "Link Expired Please Contact Admin");
                            document.getElementById("btnsubmit").disabled = false;
                        }
                    });
                }
                else {
                    DangerAlert(" ", "Recheck the fields.");
                    document.getElementById("btnsubmit").disabled = false;
                }
            });





        });
        function keyPressListener(e) {
            if (e.keyCode == 13) {
                $("#btnsubmit").click();
            }
        }
    </script>
</body>
</html>

