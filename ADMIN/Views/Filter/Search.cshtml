<script type="text/javascript">


    var srch = "";

    var myobj = new Object();

    // Get the modal
    var modal = document.getElementById('LotDetailsDIV');


    // Get the <span> element that closes the modal
    var span = document.getElementsByClassName("close")[0];

    // When the user clicks on <span> (x), close the modal
    span.onclick = function () {
        modal.style.display = "none";

    }

    // When the user clicks anywhere outside of the modal, close it
    window.onclick = function (event) {
        if (event.target == modal) {
            modal.style.display = "none";
        }
    }


    $(document).ready(function () {

        $("#srch-term").keypress(function (e) {
            if (e.which == 13) {
               // alert('You pressed enter!');
                e.preventDefault();
                $("#btnsrch").click();
            }
        });


        $("#btnsrch").click(function () {
            if ($('#srch-term').val() != "") {
               document.getElementById('srch_list').innerHTML = "";
                $("#srch_list").show();
                //var Stext = $('#srch-term').val();
                //srch = Stext.trim();
                var srchobj = new Object();
                
                srchobj.StreetName = $('[name="srch-term"]').val();
                srchobj.Zip_Code = $('[name="srch-term"]').val();
                srchobj.Score = $('[name="srch-term"]').val();

                $.get("@Url.Action("Find", "Filter")", { str: JSON.stringify(srchobj) }, function (data) {

                        var prd = "";
                        myobj = JSON.parse(data);

                    if (myobj.length != 0) {


                        for (j = 0; j < myobj.length; j++) {


                            if (myobj[j].Score != null)
                                prd += "<p onclick=showpopup(" + myobj[j].Lot_ID + ")><a href=' # '>" + myobj[j].StreetName + '--' + myobj[j].Zip_Code + '--' + myobj[j].Score + "</a></p><br/>"

                            else
                              prd += "<p onclick=showpopup(" + myobj[j].Lot_ID + ")><a href=' # '>" + myobj[j].StreetName + '--' + myobj[j].Zip_Code +'-- No score available at the moment' + "</a></p><br/>"
                              
                            $("#srch_list").html(prd);


                        }
                    } else {
                        DangerAlert("","Not Found");
                    }
                });

                 
            }
            else {
               // $("#srch_list").hide();
                document.getElementById('srch_list').innerHTML = "";
            }
        });


    });





    function showpopup(ID) {

        for (var i = 0; i < myobj.length; i++) {
            if (myobj[i].Lot_ID == ID) {

                if (myobj[i].Score == null) {
                    WarningAlert(" No score available at the moment");
                }


                var table = "";
                table += "<div class='col-4' >";
                table += "<iframe src='" + myobj[i].Floor_Plan_Path + "' alt='" + myobj[i].Product_Name + "' height='300' width='280'></iframe>";
                table += "</div>";
                table += "<div class='col-8'>";
                table += "<table class='table no-border' padding-right='5px' >";
                table += "<tbody>";
                if (myobj[i].Lot_Name != null) {
                    table += "<tr>";
                    table += "<td width='60%' style='text-align:left;'><b>Lot/House Name : </b></td>";
                    table += "<td style='text-align:left;'>" + myobj[i].Lot_Name + "</td>";
                    table += "</tr>";
                }
                table += "<tr>";
                if (myobj[i].Status != null) {
                    table += "<td style='text-align:left;'><b>Status : </b></td>";
                    table += "<td style='text-align:left;'>" + myobj[i].Status + "</td>";
                    table += "</tr>";


                    if (myobj[i].Status == 'Under Construction') {
                        table += "<tr>";
                        table += "<td style='text-align:left;'><b>Expected CompletionDate : </b></td>";
                        table += "<td style='text-align:left;'>" + SplitDates(myobj[i].Expected_CompletionDate) + "</td>";
                        table += "</tr>";
                    } else {

                    }
                }


                table += "<tr>";
                table += "<td style='text-align:left;'><b>Street Name : </b></td>";
                table += "<td style='text-align:left;'>" + myobj[i].StreetName + "</td>";
                table += "</tr>";
                table += "<tr>";
                if (myobj[i].Survey_Number != "") {
                    table += "<td style='text-align:left;'><b>Survey Number : </b></td>";
                    table += "<td style='text-align:left;'>" + myobj[i].Survey_Number + "</td>";
                    table += "</tr>";
                }
                
                table += "<tr>";
                table += "<td style='text-align:left;'><b>Zip Code : </b></td>";
                table += "<td style='text-align:left;'>" + myobj[i].Zip_Code + "</td>";
                table += "</tr>";
                if (myobj[i].Score != null) {
                    table += "<td style='text-align:left;'><b>AVA Score : </b></td>";
                    table += "<td style='text-align:left;'>" + myobj[i].Score + "</td>";
                    table += "</tr>";
                }
                table += "</tfoot>";
                table += "</table>";
                table += "</div>";


            }
        }
        $("#Lot_details").html(table);
        // $("#tbody").html(tbody);
        // $("#thead").html(thead);
        modal.style.display = "block";
    }

    function SplitDates(DatTime) {
        if (DatTime != null && DatTime != "" && DatTime != "null") {
            var da = DatTime;
            d = da.split('T')[0];
            var day = d.split('-')[2];
            var month = d.split('-')[1];
            var year = d.split('-')[0];
            d = d = da.split('T')[1];
            da = day + '-' + month + '-' + year;
            return da;
        }
        else
            return null;
    }

</script>



