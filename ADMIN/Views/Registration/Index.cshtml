
@{
    ViewBag.Title = "Registration";
}

<!-- Main content -->

<div class="content-header">
    <div class="card-header">
        <h1 class="card-title">Vehicle Loan Application</h1>
    </div>
</div>

<div class="col-lg-12 col-6">
    <!-- small box -->



    <div>
        <div class="row" style="padding: 5px; !important; text-align: right !important;">
            <div class="col-lg-4">
                <label for="exampleInputBranch" style="text-align: right !important;">Select Showroom</label>
            </div>

            <div class="col-lg-3 col-6">
                <select name="Showroom" id="Showroom" class="form-control">
                    <option value="0">-- Select --</option>
                    <option value="1">Srinath Motors</option>
                    <option value="2">Sathya Motors</option>
                </select>
            </div>
        </div>
    </div>


</div>

<!-- Hirer -->
<div class="container-fluid">
    <div class="col-md-12">
        <div class="card card-primary">

            <div class="card-header">
                <h3 class="card-title">Hirer</h3>
            </div>

            <form>

                <div class="card-body">

                    <div class="row">
                        <div class="col-sm-5">
                            <div class="form-group">
                                <label>Name</label>
                                <input type="text" name="HName" class="form-control" placeholder="Enter Hirer Name">
                            </div>
                        </div>
                        <div class="col-sm-5">
                            <div class="form-group">
                                <label>Father Name</label>
                                <input type="text" name="HFName" class="form-control" placeholder="Enter Your Father ame">
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-sm-5 col-6">
                            <!-- text input -->
                            <div class="form-group">
                                <label>Age</label>
                                <input type="number" name="HAge" required min="18" max="100" class="form-control"
                                       placeholder="Enter Your Age">
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="form-group">
                                <label>Gender</label>
                                <!-- radio -->

                                <div class="form-group">
                                    <div class="form-check">
                                        <div class="row">
                                            <div class="col-sm-3">
                                                <input class="form-check-input" type="radio" name="HGender" value="Male">
                                                <label class="form-check-label">Male</label>
                                            </div>

                                            <div class="col-sm-3">
                                                <input class="form-check-input" type="radio" name="HGender" value="Female">
                                                <label class="form-check-label">Female</label>
                                            </div>
                                            <div class="col-sm-3">
                                                <input class="form-check-input" type="radio" name="HGender" value="Others">
                                                <label class="form-check-label">Others</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-5">
                            <div class="form-group">
                                <label>Occupation</label>
                                <input type="text" name="HOccupation" class="form-control" placeholder="Enter Your Occupation">
                            </div>
                        </div>
                        <div class="col-sm-5">
                            <div class="form-group">
                                <label for="Number">Mobile Number</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="fa fa-mobile"></i></span>
                                    </div>
                                    <input type="Number" name="HMobNumber" class="form-control" placeholder="Mobile Number">
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-10">
                            <div class="form-group">
                                <label>Aadhar Number</label>
                                <input type="number" name="HAadharNo" class="form-control" required placeholder="Enter Aadhar Number">

                            </div>
                        </div>


                    </div>
                    <div class="row">

                        <div class="col-sm-5">

                            <label> Photo Hirer</label>
                            <input type="file" name="HPhoto" accept="image/*" onchange="loadFile(event)">
                            <img id="output" / height="100px" width="100px" class="Image">
                        </div>


                        <div class="col-lg-5">
                            <div class="form-group">
                                <label for="inputAddress">Address</label>
                                <textarea class="form-control" name="HAddress" id="inputAddress" required placeholder="Enter Your Address..."
                                          rows="7"></textarea>
                            </div>


                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

</div>

