<!--Loan Details-->
<div class="col-md-12">
    <div class="card card-primary">
        <div class="card-header">
            <h3 class="card-title">Loan Details</h3>
        </div>

        <form>

            <div class="card-body">
                <div class="row">
                    @*<div class="col-sm-5">
                            <div class="form-group">
                                <label>Number</label>
                                <input type="text" name="VNumber" class="form-control" placeholder="Enter Vehicle Number">
                            </div>
                        </div>*@
                    <div class="col-sm-5">
                        <div class="form-group">
                            <label>Loan Date</label>
                            <input type="date" name="VLoanDate" class="form-control" placeholder="Select Date">
                        </div>
                    </div>
                    <div class="col-sm-5">
                        <div class="form-group">
                            <label>Required Loan Amount</label>
                            <input type="text" name="VReqLoan" class="form-control" placeholder="Enter Required Loan Rs">
                        </div>
                    </div>
                </div>

                <div class="row">

                    <div class="col-sm-5">
                        <div class="form-group">
                            <label>Finance Amount</label>
                            <input type="text" name="VFinance" id="txtVFinance" class="form-control" placeholder="Enter Finance Rs" onkeyup="CalculateEMIAmount();">
                        </div>
                    </div>
                    <div class="col-sm-5">
                        <div class="form-group">
                            <label>Rate Of Interest</label>
                            <input type="text" name="VROI" id="txtVROI" class="form-control" placeholder="Enter Rate Of Interest" onkeyup="CalculateEMIAmount();">
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-5">
                        <div class="form-group">
                            <label>Period</label>
                            <input type="text" name="VPeriod" id="txtVPeriod" class="form-control" placeholder="Enter Period" onkeyup="CalculateEMIAmount();">
                        </div>
                    </div>
                    <div class="col-sm-5">
                        <div class="form-group">
                            <label>Installment Amount</label>
                            <input type="text" name="VInstallment" id="txtVInstallment" class="form-control" disabled="disabled">
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-5">
                        <div class="form-group">
                            <label>Visibility</label>
                            <input type="checkbox" name="LoanVisibility" class="form-control">
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<div style="width:90%; padding:30px 30px;">
    <div class="row">
        <div class="col-sm-2">
            <button type="button" id="btnSave" class="btn btn-success btn-block ">Save</button>
        </div>
        <div class="col-sm-2">
            <button type="button" id="Cancel" class="btn btn-primary btn-block ">Cancel</button>
        </div>
    </div>
</div>



