        //}

        //$('#login').validate({
        //    rules: {
        //        UserName: {
        //            required: true,
        //        },
        //        Password: {
        //            required: true,
        //        },
        //    }
        //});

        //var form = $("#login");
        //form.validate();

        $(document).ready(function () {
            //$('[name="UserName"]').val(localStorage.getItem('UserName'));
            $("#btnSave").click(function () {
                //if (form.valid()) {
                document.getElementById("btnSave").disabled = true;

                var myobj = new Object();

                myobj.BranchID = $('#Showroom').val();
                //Hirer
                myobj.HirerName = $('[name="HName"]').val();
                myobj.HirerFathername = $('[name="HFName"]').val();
                myobj.HirerAge = $('[name="HAge"]').val();
                myobj.HirerOccupation = $('[name="HOccupation"]').val();
                myobj.HirerMobileNumber = $('[name="HMobNumber"]').val();
                myobj.HirerAddress = $('[name="HAddress"]').val();
                myobj.HirerGender = $('input[name="HGender"]:checked').val();
                myobj.HirerAadharNumber = $('[name="HAadharNo"]').val();

                //Guarantor
                myobj.GuarantorName = $('[name="GName"]').val();
                myobj.GuarantorFathername = $('[name="GFName"]').val();
                myobj.GuarantorAge = $('[name="GAge"]').val();
                myobj.GuarantorMobileNumber = $('[name="GMobNumber"]').val();
                myobj.GuarantorAddress = $('[name="GAddress"]').val();
                myobj.GuarantorGender = $('input[name="GGender"]:checked').val();
                myobj.GuarantorAadharNumber = $('[name="GAadharNo"]').val();

                // vehicle
                myobj.VehicleName = $('[name="VName"]').val();
                myobj.EngineNo = $('[name="VEngineNo"]').val();
                myobj.ChassisNo = $('[name="VChasisNo"]').val();
                myobj.Model = $('[name="VModel"]').val();
                myobj.KeyNo = $('[name="VKeyNo"]').val();
                myobj.VehicleNo = $('[name="VNo"]').val();
                myobj.VehicleOnRoadRs = $('[name="VOnRoad"]').val();


                //Loan
                myobj.LoanDate = $('[name="VLoanDate"]').val();
                myobj.FinanceRs = $('[name="VFinance"]').val();
                myobj.Interest = $('[name="VROI"]').val();
                myobj.Period = $('[name="VPeriod"]').val();
                myobj.Installment = $('[name="VInstallment"]').val();
                myobj.RequiredLoanRs = $('[name="VReqLoan"]').val();
                myobj.LoanVisibility = $('[name="VReqLoan"]').val();
                myobj.LoanVisibility = $("#LoanVisibility").attr("checked") ? true : false; //$('[name="LoanVisibility"]').val();


                //myobj.HirerPhoto = $('[name="HPhoto"]').val();
                //myobj.GuarantorPhoto = $('[name="HPhoto"]').val();
                //myobj.VehiclePhoto = $('[name="HPhoto"]').val();


                $.post("@Url.Action("SaveRegistration", "Registration")", { ObjRegister: JSON.stringify(myobj) }, function (data) {
                    var Res = JSON.parse(data);
                   // alert(Res);
                    //if (Res.StatusCode == 200) {
                     var Res = JSON.parse(data);
                    if (Res > 0) {
                        SuccessAlert("@ViewBag.Title", "Added Successfully.");
                        //ClearFields();
                        //BindTableData();
                    }
                    else {
                        WarningAlert("@ViewBag.Title", "Not Saved. Some issue");
                    }

                    });
            });
        });



    function CalculateEMIAmount() {

        var LoanAmount = document.getElementById("txtVFinance").value;
        var InterestRate = document.getElementById("txtVROI").value;
        var PaymentPeriods = document.getElementById("txtVPeriod").value;

        if (LoanAmount != null && InterestRate != null && PaymentPeriods != null && LoanAmount != undefined && InterestRate != undefined && PaymentPeriods != undefined && LoanAmount != "" && InterestRate != "" && PaymentPeriods != "" && PaymentPeriods != "0") {

            var InterestAmount = (((LoanAmount * InterestRate) / 100) / 12) * PaymentPeriods;
            var TotalAmount = parseInt(InterestAmount) + parseInt(LoanAmount);
            var EMIAmt = Math.round(TotalAmount / PaymentPeriods);
            $('#txtVInstallment').val(EMIAmt);

        }
        else {
            $('#txtVInstallment').val("");
        }
    }


</script>
