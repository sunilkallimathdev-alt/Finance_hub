                                <label for="inputAddress">Address</label>
                                <textarea class="form-control" name="GAddress" id="inputAddress" required placeholder="Enter Your Address..."
                                          rows="4"></textarea>
                            </div>
                            <form>
                                <div class="row">
                                    <div class="col-sm-6">
                                        <div class="form-group">
                                            <label> Photo Guarantor</label><br>
                                            <input type="file" name="GPhoto" accept="image/*" onchange="loadFile2(event)">
