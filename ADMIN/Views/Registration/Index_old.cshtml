
@{
    ViewBag.Title = "Registration";
}

<!-- Content Header (Page header) -->
<!-- /.content-header -->
<!-- Main content -->
<div class="content-header">
    <div class="card-header">
        <h1 class="card-title">Vehicle Loan Application</h1>
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        <!-- left column -->
        <div class="col-md-12">
            <div class="card card-primary">

                <div class="card-header">
                    <h3 class="card-title">Hirer</h3>
                </div>

                <form>
                    <div class="row">
                        <div class="card-body">

                            <div class="row">
                                <div class="col-sm-6">
                                    <div class="form-group">
                                        <label>Name</label>
                                        <input type="text" name="HName" class="form-control" placeholder="Enter Hirer Name">
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="form-group">
                                        <label>Father Name</label>
                                        <input type="text" name="HFName" class="form-control" placeholder="Enter Your Father ame">
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-sm-2">
                                    <!-- text input -->
                                    <div class="form-group">
                                        <label>Age</label>
                                        <input type="number" name="HAge" required min="18" max="100" class="form-control"
                                               placeholder="Enter Your Age">
                                    </div>
                                </div>
                                <div class="col-sm-4">
                                    <div class="form-group">
                                        <label>Occupation</label>
                                        <input type="text" name="HOccupation" class="form-control" placeholder="Enter Your Occupation">
                                    </div>
                                </div>
                                &nbsp;
                                <div class="col-sm-3">
                                    <div class="form-group">
                                        <label>Mobile Number</label>
                                        <input type="number" name="HMobNumber" class="form-control" we>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">

                                <label for="inputAddress">Address</label>
                                <textarea class="form-control" name="HAddress" id="inputAddress" required placeholder="Enter Your Address..."
                                          rows="4"></textarea>
                            </div>


                            <div class="row">

                                <div class="col-sm-6">

                                    <label> Photo Hirer</label>
                                    <input type="file" name="HPhoto" accept="image/*" onchange="loadFile(event)">
                                    <img id="output" / height="100px" width="100px" class="Image">
                                </div>


                                <div class="col-sm-6">
                                    <div class="form-group">
                                        <label> Signiture Hirer</label>

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
            </div>
            </form>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        <!-- left column -->
        <div class="col-md-12">
