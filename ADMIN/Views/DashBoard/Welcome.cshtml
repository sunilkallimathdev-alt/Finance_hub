
@{
    ViewBag.Title = "Welcome";
}

@*<h1><strong> Welcome To Admin Panel</strong></h1>*@
<!-- Content Header (Page header) -->
<!-- searchbar-->
<div class="col-lg-12 col-6">
    <!-- small box -->
    <div class="small-box">
        <div class="inner">
            <div class="row">
                <div class="col-lg-6 col-6">
                    <input type="text" name="LoanId" class="form-control" placeholder="Mobile Number / Vehicle Number / Aadhar Number" width="500">
                </div>
                <div class="col-lg-3 col-6">
                    <button type="button" id="submit" class="btn btn-info">Search <i class="nav-icon fa fa-search"></i></button>
                </div>
            </div>
        </div>
    </div>
</div>







<div class="container-fluid">
    <!-- Small boxes (Stat box) -->
    <div class="row">
        <div class="col-lg-3 col-6">
            <!-- small box -->
            <div class="small-box bg-info">
                <div class="inner">
                    <h3><span id="dvTotalCust"></span></h3>

                    <p>Total Number of Customers</p>
                </div>
                <div class="icon">
                    <i class="fa fa-users"></i>
                </div>
                <a href="../UserDetails/Index" class="small-box-footer">More info <i class="fa fa-arrow-circle-right"></i></a>
            </div>
        </div>
        <!-- ./col -->
        <div class="col-lg-3 col-6">
            <!-- small box -->
            <div class="small-box bg-success">
                <div class="inner">
                    <h3><span id="dvPaidCust"></span></h3>

                    <p>Paid Customers </p>
                </div>
                <div class="icon">
                    <i class="fa fa-star"></i>
                </div>
                <a href="#" class="small-box-footer">More info <i class="fa fa-arrow-circle-right"></i></a>
            </div>
        </div>
        <!-- ./col -->
        <div class="col-lg-3 col-6">
            <!-- small box -->
            <div class="small-box bg-warning">
                <div class="inner">
                    <h3><span id="dvUnpdCust"></span></h3>

                    <p>Last Unpaid</p>
                </div>
                <div class="icon">
                    <i class="fa fa-star-half-empty"></i>
                </div>
                <a href="#" class="small-box-footer">More info <i class="fa fa-arrow-circle-right"></i></a>
            </div>
        </div>
        <!-- ./col -->
        <div class="col-lg-3 col-6">
            <!-- small box -->
            <div class="small-box bg-danger">
                <div class="inner">
                    <h3><span id="dvDefaulterCust"></span></h3>

                    <p>Defaulters</p>
                </div>
                <div class="icon">
                    <i class="fa fa-hourglass-start"></i>
                </div>
                <a href="#" class="small-box-footer">More info <i class="fa fa-arrow-circle-right"></i></a>
            </div>
        </div>
        <!-- ./col -->
    </div>
    <!-- /.row -->

    <section class="content">
        <div class="container-fluid">



            <div class="row">
                <!-- left column -->
                <div class="col-md-12">
                    <div class="card card-primary">
                        <div class="card-header">
                            <h3 class="card-title">Allotted</h3>
                        </div>
                        <form>
                            <div class="card-body">

                                <div class="form-group">
                                    <label for="exampleInputBranch">Select Showroom</label>
                                    <select name="state" id="state" class="form-control">
                                        <option value="1">Srinath Motors</option>
                                        <option value="2">Sathya Motors</option>                                        
                                    </select>
                                </div>

                                <div class="row">
                                    <div class="col-12 col-sm-6 col-md-4">
                                        <div class="info-box">
                                            <span class="info-box-icon bg-info elevation-1"><i class="fas fa-cog"></i></span>

                                            <div class="info-box-content">
                                                <span class="info-box-text">Allotted Amount</span>
                                                <span class="info-box-number">
                                                    Rs.10000.00
                                                </span>
                                            </div>
                                            <!-- /.info-box-content -->
                                        </div>
                                        <!-- /.info-box -->
                                    </div>
                                    <!-- /.col -->

                                    <div class="col-12 col-sm-6 col-md-4">
                                        <div class="info-box mb-3">
                                            <span class="info-box-icon bg-success elevation-1"><i class="fas fa-shopping-cart"></i></span>

                                            <div class="info-box-content">
                                                <span class="info-box-text">Utilised Amount</span>
                                                <span class="info-box-number">Rs.50000.00</span>
                                            </div>
                                            <!-- /.info-box-content -->
                                        </div>
                                        <!-- /.info-box -->
                                    </div>

                                    <!-- /.col -->
                                    <!-- fix for small devices only -->
                                    <div class="clearfix hidden-md-up"></div>



                                    <div class="col-12 col-sm-6 col-md-4">
                                        <div class="info-box mb-3">
                                            <span class="info-box-icon bg-danger elevation-1"><i class="fas fa-thumbs-up"></i></span>

                                            <div class="info-box-content">
                                                <span class="info-box-text">Remaining Amount</span>
                                                <span class="info-box-number">Rs.50,000.00</span>
                                            </div>
                                            <!-- /.info-box-content -->
                                        </div>
                                        <!-- /.info-box -->
                                    </div>
                                    <!-- /.col -->

                                </div>



                                <section class="col-lg-12 connectedSortable ui-sortable">


                                    <!-- solid sales graph -->

                                    <div class="card bg-gradient-info">
                                        <div class="card-header border-0">
                                            <h3 class="card-title">
                                                <i class="fa fa-th mr-1"></i>
                                                Fund Utilization
                                            </h3>

                                            <div class="card-tools">
                                                <button type="button" class="btn bg-info btn-sm" data-card-widget="collapse">
                                                    <i class="fa fa-minus"></i>
                                                </button>
                                                <button type="button" class="btn bg-info btn-sm" data-card-widget="remove">
                                                    <i class="fa fa-times"></i>
                                                </button>
                                            </div>
                                        </div>

                                        <div class="card-body">
                                            <canvas class="chart" id="line-chart" style="height: 250px;  width: 1000pt;"></canvas>
                                        </div>
                                    </div>
                                </section>


                            </div>
                        </form>
                    </div>
                </div>


            </div>

            <!-- left column -->






        </div>
    </section>

    <section class="content">
        <div class="container-fluid">

            <div class="row">
                <div class="col-md-6">
                    <div class="card card-primary">
                        <div class="card-header">
                            <h3 class="card-title">Allocate Funds</h3>
                        </div>
                        <form>
                            <div class="card-body">
                                <div class="form-group">
                                    <label for="exampleInputBranch">Select Branch</label>
                                    <select name="state" id="state" class="form-control">
                                        <option value="1">Srinath Motors</option>
                                        <option value="2">Sathya Motors</option>
                                    </select>
                                </div>


                                <div class="form-group">
                                    <label for="exampleInputEmail1">Add Funds</label>
                                    <input type="email" class="form-control" id="exampleInputEmail1" placeholder="Enter Add Funds">
                                </div>

                                <div class="form-group">
                                    <label for="exampleInputEmail1">Deposited by</label>
                                    <input type="email" class="form-control" id="exampleInputEmail1" placeholder="Deposited">
                                </div>
                                <!-- Date -->
                                <!-- Date -->
                                <div class="form-group">
                                    <label>Date:</label>
                                    <div class="input-group date" id="reservationdate" data-target-input="nearest">
                                        <input type="text" class="form-control datetimepicker-input" data-target="#reservationdate" />
                                        <div class="input-group-append" data-target="#reservationdate" data-toggle="datetimepicker">
                                            <div class="input-group-text"><i class="fa fa-calendar"></i></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            <!-- left column -->

        </div>
    </section>

</div>
<!-- /.content-wrapper -->

<script src="~/CustomFiles/plugins/jquery/jquery.min.js"></script>

<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.16.0/jquery.validate.js"></script>
<script src="https://cdn.jsdelivr.net/jquery.validation/1.16.0/additional-methods.min.js"></script>
<script src="~/CustomFiles/js/Common_js.js"></script>
<script src="~/CustomFiles/dist/js/toastr.min.js"></script>
<script src="~/CustomFiles/plugins/chart.js/Chart.min.js"></script>
<script src="~/CustomFiles/plugins/select2/select2.full.min.js"></script>
<link rel="stylesheet" href="~/CustomFiles/plugins/fontawesome-free/css/all.min.css">
<script>

    $(document).ready(function () {

        BindDashBoardData();

    });

    function BindDashBoardData() {
        
        $.post("@Url.Action("GetDashoboardData", "DashBoard")", function (data) {
            var myObject = JSON.parse(data);

            $('#dvTotalCust').html(myObject.TotalCustomers);
            $('#dvPaidCust').html(myObject.Nodue);
            $('#dvUnpdCust').html(myObject.Due);
            $('#dvDefaulterCust').html(myObject.Defaulter);

        });
    }


</script>
